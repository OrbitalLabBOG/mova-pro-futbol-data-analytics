{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mova.orbitallab.ai/contracts/operator-doctor-v1.schema.json",
  "title": "MOVA FPL operator doctor v1",
  "type": "object",
  "required": [
    "schema", "schema_version", "command", "generated_at", "overall_status",
    "summary", "checks"
  ],
  "properties": {
    "schema": {"const": "mova-fpl-operator-v1"},
    "schema_version": {"const": "1.0"},
    "command": {"const": "doctor"},
    "generated_at": {"type": "string", "format": "date-time"},
    "overall_status": {"enum": ["healthy", "degraded", "failed"]},
    "summary": {
      "type": "object",
      "required": ["pass", "warn", "fail", "required_failures"],
      "additionalProperties": false,
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "warn": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "required_failures": {"type": "integer", "minimum": 0}
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "required", "summary", "detail"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["PASS", "WARN", "FAIL"]},
          "required": {"type": "boolean"},
          "summary": {"type": "string"},
          "detail": {"type": "object"}
        }
      }
    }
  },
  "additionalProperties": false
}
