{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mova.orbitallab.ai/contracts/week-brief-v1.schema.json",
  "title": "MOVA FPL week brief v1 (modelo copiloto, ADR-021)",
  "description": "Salida de `mova week brief --gw N --json`. Cada sección declara su estado; el brief nunca falla por datos faltantes y no muta runtime ni FPL.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "generated_at", "season", "gw", "cycle_id", "team_id", "operating_model",
    "overall", "inputs", "missing_on_vps", "sections", "runtime_mutated", "fpl_mutated"
  ],
  "properties": {
    "schema": {"type": "string", "const": "mova-week-brief-v1"},
    "generated_at": {"type": "string"},
    "season": {"type": "string"},
    "gw": {"type": "integer", "minimum": 1, "maximum": 38},
    "cycle_id": {"type": "string"},
    "team_id": {"type": "integer"},
    "operating_model": {"type": "string", "enum": ["copilot", "scheduled_delivery"]},
    "overall": {"type": "string", "enum": ["ready", "partial", "empty"]},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "acta", "chips", "horizon", "ops_db_present", "network_error"],
      "properties": {
        "network": {"type": "boolean"},
        "acta": {"type": "boolean"},
        "chips": {"type": "boolean"},
        "horizon": {"type": "integer", "minimum": 1},
        "ops_db_present": {"type": "boolean"},
        "network_error": {"type": ["string", "null"]}
      }
    },
    "missing_on_vps": {
      "type": "array",
      "items": {"$ref": "#/$defs/section_name"}
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle", "authority", "squad", "acta", "flags", "projections", "strategy_reasons",
        "research_signals", "lessons", "execution", "open_decisions"
      ],
      "properties": {
        "cycle": {"$ref": "#/$defs/section"},
        "authority": {"$ref": "#/$defs/section"},
        "squad": {"$ref": "#/$defs/section"},
        "acta": {"$ref": "#/$defs/section"},
        "flags": {"$ref": "#/$defs/section"},
        "projections": {"$ref": "#/$defs/section"},
        "strategy_reasons": {"$ref": "#/$defs/section"},
        "research_signals": {"$ref": "#/$defs/section"},
        "lessons": {"$ref": "#/$defs/section"},
        "execution": {"$ref": "#/$defs/section"},
        "open_decisions": {"$ref": "#/$defs/open_decisions"}
      }
    },
    "runtime_mutated": {"type": "boolean", "const": false},
    "fpl_mutated": {"type": "boolean", "const": false}
  },
  "$defs": {
    "section_name": {
      "type": "string",
      "enum": [
        "cycle", "authority", "squad", "acta", "flags", "projections", "strategy_reasons",
        "research_signals", "lessons", "execution", "open_decisions"
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "needs_vps", "data"],
      "properties": {
        "status": {"type": "string", "enum": ["ok", "missing", "degraded", "error", "skipped"]},
        "source": {"type": ["string", "null"]},
        "needs_vps": {"type": "boolean"},
        "detail": {"type": "string"},
        "data": {"type": ["object", "array", "null"]}
      }
    },
    "open_decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "needs_vps", "data"],
      "properties": {
        "status": {"type": "string", "enum": ["ok", "error"]},
        "source": {"type": "string", "const": "derived"},
        "needs_vps": {"type": "boolean"},
        "detail": {"type": "string"},
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "severity", "text"],
            "properties": {
              "code": {"type": "string"},
              "severity": {"type": "string", "enum": ["blocker", "decide", "info"]},
              "text": {"type": "string"},
              "detail": {"type": "object"}
            }
          }
        }
      }
    }
  }
}
