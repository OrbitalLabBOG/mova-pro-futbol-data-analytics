{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-request-v1.schema.json",
  "title": "MOVA ResearchRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "agent_run_id",
    "correlation_id",
    "created_at",
    "cutoff_at",
    "cycle",
    "task",
    "subjects",
    "official_facts",
    "input_artifacts",
    "previous_signal_refs",
    "source_policy_version",
    "provider_policy_version",
    "capabilities",
    "search_policy",
    "budgets",
    "input_manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "mova-research-request-v1"},
    "request_id": {"type": "string", "pattern": "^rr_[A-Za-z0-9_-]{8,80}$"},
    "agent_run_id": {"type": "string", "pattern": "^ar_[A-Za-z0-9_-]{8,80}$"},
    "correlation_id": {"type": "string", "minLength": 8, "maxLength": 120},
    "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "cutoff_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycle_id", "season", "gw", "phase", "deadline_at"],
      "properties": {
        "cycle_id": {"type": "string", "pattern": "^cycle_[A-Za-z0-9_-]{8,80}$"},
        "season": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
        "gw": {"type": "integer", "minimum": 1, "maximum": 38},
        "phase": {
          "enum": [
            "baseline",
            "research",
            "refresh",
            "preflight",
            "freeze",
            "execution_window",
            "verification_window",
            "hard_stop",
            "settlement"
          ]
        },
        "deadline_at": {"type": "string", "format": "date-time", "pattern": "Z$"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "prompt_sha256", "output_schema_sha256"],
      "properties": {
        "name": {
          "enum": [
            "news_discovery",
            "source_extract",
            "signal_reconcile",
            "deadline_brief",
            "decision_critic",
            "log_diagnosis"
          ]
        },
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "output_schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "subjects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owned_elements", "candidate_elements", "clubs"],
      "properties": {
        "owned_elements": {
          "type": "array",
          "maxItems": 15,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "candidate_elements": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "clubs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    },
    "official_facts": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "fact_type", "subject_ref", "value", "observed_at", "source_ref", "sha256"],
        "properties": {
          "fact_id": {"type": "string", "minLength": 8, "maxLength": 100},
          "fact_type": {"type": "string", "minLength": 1, "maxLength": 80},
          "subject_ref": {"type": "string", "minLength": 1, "maxLength": 100},
          "value": {},
          "observed_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
          "source_ref": {"type": "string", "minLength": 1, "maxLength": 160},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "input_artifacts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "sha256", "bytes", "media_type", "classification"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).{1,500}$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 10485760},
          "media_type": {"type": "string", "minLength": 1, "maxLength": 120},
          "classification": {"enum": ["public", "internal_redacted"]}
        }
      }
    },
    "previous_signal_refs": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sig_[A-Za-z0-9_-]{8,80}$"}
    },
    "source_policy_version": {"type": "string", "minLength": 1, "maxLength": 100},
    "provider_policy_version": {"type": "string", "minLength": 1, "maxLength": 100},
    "capabilities": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["web_search", "http_fetch", "read_bundle"]}
    },
    "search_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "allowed_domains", "blocked_domains", "query_templates"],
      "properties": {
        "engine": {"enum": ["none", "exa", "firecrawl", "parallel", "perplexity", "codex"]},
        "allowed_domains": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 253}
        },
        "blocked_domains": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 253}
        },
        "query_templates": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_seconds",
        "model_request_limit",
        "transport_retry_limit",
        "tool_call_limit",
        "search_request_limit",
        "search_result_limit",
        "document_limit",
        "input_bytes_limit",
        "output_tokens_limit",
        "total_tokens_limit",
        "max_cost_usd"
      ],
      "properties": {
        "wall_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "model_request_limit": {"type": "integer", "minimum": 0, "maximum": 10},
        "transport_retry_limit": {"type": "integer", "minimum": 0, "maximum": 3},
        "tool_call_limit": {"type": "integer", "minimum": 0, "maximum": 10},
        "search_request_limit": {"type": "integer", "minimum": 0, "maximum": 10},
        "search_result_limit": {"type": "integer", "minimum": 0, "maximum": 50},
        "document_limit": {"type": "integer", "minimum": 0, "maximum": 50},
        "input_bytes_limit": {"type": "integer", "minimum": 1, "maximum": 10485760},
        "output_tokens_limit": {"type": "integer", "minimum": 1, "maximum": 10000},
        "total_tokens_limit": {"type": "integer", "minimum": 1, "maximum": 500000},
        "max_cost_usd": {
          "oneOf": [
            {"type": "number", "exclusiveMinimum": 0, "maximum": 5},
            {"type": "null"}
          ]
        }
      }
    },
    "input_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
