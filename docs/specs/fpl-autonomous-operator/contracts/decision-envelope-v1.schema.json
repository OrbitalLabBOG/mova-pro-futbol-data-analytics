{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mova.local/contracts/decision-envelope-v1.schema.json",
  "title": "MOVA DecisionEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "policy_version", "cycle_id", "season", "gw", "mode", "status",
    "manifest", "selected_candidate_key", "selected_fingerprint", "candidates",
    "comparisons", "validation", "controls", "engine", "event_context", "team_state",
    "report_artifact", "envelope_id", "content_sha256"
  ],
  "properties": {
    "schema": {"const": "mova-decision-envelope-v1"},
    "policy_version": {"type": "string", "minLength": 1},
    "cycle_id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-gw[0-9]{2}$"},
    "season": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "gw": {"type": "integer", "minimum": 1, "maximum": 38},
    "mode": {"const": "shadow"},
    "status": {"enum": ["blocked", "staged", "superseded"]},
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "content_sha256", "revision", "as_of_at"],
      "properties": {
        "manifest_id": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "revision": {"type": "integer", "minimum": 1},
        "as_of_at": {"type": "string", "format": "date-time"}
      }
    },
    "selected_candidate_key": {"const": "milp_baseline"},
    "selected_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "candidates": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "comparisons": {"type": "array", "minItems": 2, "maxItems": 2},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blocking_codes", "checks"],
      "properties": {
        "status": {"enum": ["blocked", "staged"]},
        "blocking_codes": {"type": "array", "items": {"type": "string"}},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}
      }
    },
    "controls": {"type": "object"},
    "engine": {"type": "object"},
    "event_context": {"type": "object"},
    "team_state": {"type": "object"},
    "report_artifact": {"type": ["object", "null"]},
    "envelope_id": {"type": "string", "pattern": "^envelope_[0-9a-f]{24}$"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_key", "label", "decision", "violations"],
      "properties": {
        "candidate_key": {
          "enum": ["do_nothing", "milp_baseline", "primary_alternative"]
        },
        "label": {"type": "string", "minLength": 1},
        "decision": {"$ref": "#/$defs/decision"},
        "violations": {"type": "array", "items": {"type": "object"}}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "season", "gw", "squad_15", "starters", "captain", "vice_captain",
        "bench_order", "transfers_in", "transfers_out", "hits", "chip",
        "expected_points", "total_cost", "bank_after", "policy", "notes", "fingerprint"
      ],
      "properties": {
        "season": {"type": "string"}, "gw": {"type": "integer"},
        "squad_15": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"type": "integer"}},
        "starters": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"type": "integer"}},
        "captain": {"type": ["integer", "null"]},
        "vice_captain": {"type": ["integer", "null"]},
        "bench_order": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer"}},
        "transfers_in": {"type": "array", "items": {"type": "integer"}},
        "transfers_out": {"type": "array", "items": {"type": "integer"}},
        "hits": {"type": "integer", "minimum": 0},
        "chip": {"type": ["string", "null"]},
        "expected_points": {"type": "number"}, "total_cost": {"type": "number"},
        "bank_after": {"type": "number"}, "policy": {"type": "string"},
        "notes": {"type": "array", "items": {"type": "string"}},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "passed", "severity", "summary", "detail"],
      "properties": {
        "code": {"type": "string"}, "passed": {"type": "boolean"},
        "severity": {"enum": ["info", "warning", "block"]},
        "summary": {"type": "string"}, "detail": {"type": "object"}
      }
    }
  }
}
