{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mova.local/contracts/manual-verified-execution-v2.schema.json",
  "title": "MOVA manual verified execution v2",
  "type": "object",
  "required": [
    "schema", "season", "gw", "cycle_id", "deadline_at", "authorization",
    "decision", "strategy", "execution", "pre_team_state", "post_team_state",
    "verification_checks"
  ],
  "properties": {
    "schema": {"const": "mova-fpl-manual-verified-execution-v2"},
    "season": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "gw": {"type": "integer", "minimum": 1, "maximum": 38},
    "cycle_id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-gw[0-9]{2}$"},
    "deadline_at": {"type": "string", "format": "date-time"},
    "authorization": {
      "type": "object",
      "required": [
        "action_level", "risk_class", "authorized_by", "policy_version",
        "authorized_at", "expires_at", "allowed_operations"
      ],
      "properties": {
        "action_level": {"enum": ["A2", "A3"]},
        "risk_class": {"enum": ["R2", "R3"]},
        "authorized_by": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "authorized_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "allowed_operations": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["lineup", "captaincy", "transfers", "hits", "chip"]}
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "decision_id", "mode", "policy_version", "status", "chip", "transfers",
        "fingerprint", "players", "artifact_path", "manifest_sha256"
      ],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["supervised", "guarded_human_reviewed"]},
        "policy_version": {"type": "string", "minLength": 1},
        "status": {"const": "executed_verified"},
        "expected_points": {"type": ["number", "null"]},
        "chip": {"enum": [null, "wildcard", "freehit", "bboost", "3xc"]},
        "transfers": {
          "type": "object", "required": ["out", "in", "hits"],
          "properties": {
            "out": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
            "in": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
            "hits": {"type": "integer", "minimum": 0, "multipleOf": 4}
          },
          "additionalProperties": false
        },
        "fingerprint": {"type": "string", "minLength": 1},
        "players": {
          "type": "array", "minItems": 15, "maxItems": 15,
          "items": {
            "type": "object",
            "required": ["element", "squad_position", "role", "is_captain", "is_vice_captain"],
            "properties": {
              "element": {"type": "integer", "minimum": 1},
              "squad_position": {"type": "integer", "minimum": 1, "maximum": 15},
              "role": {"enum": ["starter", "bench"]},
              "is_captain": {"type": "boolean"},
              "is_vice_captain": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "artifact_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "strategy": {
      "type": "object",
      "required": [
        "strategy_id", "window_name", "policy_version", "inventory",
        "recommended_chip", "status", "manifest_sha256", "rationale"
      ],
      "properties": {
        "strategy_id": {"type": "string", "minLength": 1},
        "window_name": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "inventory": {"type": "object"},
        "recommended_chip": {"type": ["string", "null"]},
        "status": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "execution_id", "action_level", "envelope_sha256", "status", "started_at",
        "finished_at", "evidence_path", "evidence_sha256"
      ],
      "properties": {
        "execution_id": {"type": "string", "minLength": 1},
        "action_level": {"enum": ["A2", "A3"]},
        "envelope_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"const": "verified"},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "evidence_path": {"type": "string", "minLength": 1},
        "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "pre_team_state": {"$ref": "#/$defs/teamStateReference"},
    "post_team_state": {"$ref": "#/$defs/teamStateReference"},
    "verification_checks": {
      "type": "array", "minItems": 4,
      "items": {
        "type": "object",
        "required": ["check_id", "check_name", "expected", "observed", "passed"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "check_name": {"enum": ["authorization", "pre_state", "post_reload_state", "exact_diff"]},
          "expected": {}, "observed": {}, "passed": {"const": true}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "teamStateReference": {
      "type": "object",
      "required": ["artifact_path", "payload_sha256", "fingerprint"],
      "properties": {
        "team_state_id": {"type": "string", "minLength": 1},
        "artifact_path": {"type": "string", "minLength": 1},
        "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "fingerprint": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"authorization": {"properties": {"action_level": {"const": "A2"}}}}},
      "then": {
        "properties": {
          "authorization": {
            "properties": {
              "risk_class": {"const": "R2"},
              "allowed_operations": {
                "items": {"enum": ["lineup", "captaincy"]}
              }
            }
          },
          "execution": {"properties": {"action_level": {"const": "A2"}}}
        }
      }
    },
    {
      "if": {"properties": {"authorization": {"properties": {"action_level": {"const": "A3"}}}}},
      "then": {
        "properties": {
          "authorization": {"properties": {"risk_class": {"const": "R3"}}},
          "execution": {"properties": {"action_level": {"const": "A3"}}}
        }
      }
    }
  ],
  "additionalProperties": false
}
