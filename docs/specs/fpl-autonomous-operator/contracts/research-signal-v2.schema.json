{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-signal-v2.schema.json",
  "title": "MOVA ResearchSignal v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signal_id",
    "cycle_id",
    "subject",
    "claim_type",
    "claim",
    "claim_status",
    "direction",
    "effective_from",
    "expires_at",
    "confidence",
    "source_refs",
    "evidence_refs",
    "corroboration",
    "effect_hint",
    "evidence_sha256",
    "generated_by",
    "validation_status"
  ],
  "properties": {
    "schema_version": {"const": "mova-research-signal-v2"},
    "signal_id": {"type": "string", "pattern": "^sig_[A-Za-z0-9_-]{8,80}$"},
    "cycle_id": {"type": "string", "pattern": "^cycle_[A-Za-z0-9_-]{8,80}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "element", "canonical_name", "club_id"],
      "properties": {
        "type": {"enum": ["player", "club"]},
        "element": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "canonical_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "club_id": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        }
      }
    },
    "claim_type": {
      "enum": [
        "availability",
        "injury",
        "suspension",
        "predicted_lineup",
        "minutes_role",
        "set_piece_role",
        "registration",
        "transfer",
        "discipline",
        "manager_quote",
        "price_change",
        "schedule_change"
      ]
    },
    "claim": {"type": "string", "minLength": 1, "maxLength": 1200},
    "claim_status": {
      "enum": ["confirmed", "reported", "predicted", "inferred", "retracted"]
    },
    "direction": {"enum": ["positive", "negative", "neutral", "mixed"]},
    "effective_from": {
      "oneOf": [
        {"type": "string", "format": "date-time", "pattern": "Z$"},
        {"type": "null"}
      ]
    },
    "expires_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^doc_[A-Za-z0-9_-]{8,80}$"}
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "locator_type", "locator", "excerpt_sha256"],
        "properties": {
          "document_id": {"type": "string", "pattern": "^doc_[A-Za-z0-9_-]{8,80}$"},
          "locator_type": {"enum": ["normalized_char_range", "json_pointer", "page"]},
          "locator": {"type": "string", "minLength": 1, "maxLength": 200},
          "excerpt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "corroboration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent_sources", "highest_tier", "conflict_group_id"],
      "properties": {
        "independent_sources": {"type": "integer", "minimum": 0, "maximum": 10},
        "highest_tier": {"enum": ["T1", "T2", "T3", "T4", "T5", "unknown"]},
        "conflict_group_id": {
          "oneOf": [
            {"type": "string", "pattern": "^conf_[A-Za-z0-9_-]{8,80}$"},
            {"type": "null"}
          ]
        }
      }
    },
    "effect_hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "direction", "magnitude"],
      "properties": {
        "metric": {
          "enum": [
            "availability_probability",
            "minutes_probability",
            "squad_role",
            "set_piece_share",
            "registration",
            "schedule",
            "price"
          ]
        },
        "direction": {"enum": ["increase", "decrease", "unchanged", "unknown"]},
        "magnitude": {"enum": ["none", "minor", "material", "critical", "unknown"]}
      }
    },
    "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generated_by": {"type": "string", "pattern": "^ar_[A-Za-z0-9_-]{8,80}$"},
    "validation_status": {"const": "candidate"}
  }
}
