# No contiene credenciales. Se instala como /etc/mova-fpl/runtime.env (0640).
MOVA_SEASON=2026-27
MOVA_TEAM_ID=3609854
MOVA_MODE=shadow
MOVA_ACTION_LEVEL=A0
MOVA_COMPLIANCE_GATE=pending
MOVA_ENABLE_SHADOW_DECISION=1
MOVA_ENABLE_BROWSER_WRITES=0
MOVA_OPS_DB=/var/lib/mova-fpl/db/ops.db
MOVA_TRACE_DB=/var/lib/mova-fpl/db/trace.db
MOVA_CANONICAL_DB=/var/lib/mova-fpl/db/fpl_canonical.db
MOVA_ARTIFACT_ROOT=/var/lib/mova-fpl/artifacts
MOVA_BACKUP_ROOT=/opt/orbital/backups/mova-fpl
MOVA_HOST_PROBE_PATH=/var/lib/mova-fpl/runtime/host-probe.json
MOVA_LOCK_PATH=/var/lib/mova-fpl/mova-fpl.lock
MOVA_SQLITE_MIN_VERSION=3.51.3
MOVA_MEMORY_GATE_BYTES=2684354560
MOVA_DISK_GATE_BYTES=21474836480
MOVA_API_HOST=0.0.0.0
MOVA_API_PORT=8787
MOVA_TICK_BUCKET_SECONDS=300
MOVA_DECISION_TIMEOUT_SECONDS=600
MOVA_PRIVATE_STATE_MAX_AGE_SECONDS=21600
MOVA_COLLECTOR_LOCK_PATH=/var/lib/mova-fpl/mova-fpl-collector.lock
MOVA_COLLECTOR_ROOT=/var/lib/mova-fpl/artifacts/data-service
MOVA_ANALYTICS_ROOT=/var/lib/mova-fpl/artifacts/analytics-service
MOVA_ANALYTICS_LOCK_PATH=/var/lib/mova-fpl/mova-fpl-analytics.lock
MOVA_MINUTES_MODEL_VERSION=1.0.0
MOVA_POINTS_MODEL_VERSION=1.0.0
MOVA_ANALYTICS_REFERENCE_GAMEWEEKS=6
MOVA_STRATEGIC_ROOT=/var/lib/mova-fpl/artifacts/strategic-context
MOVA_RESEARCH_ROOT=/var/lib/mova-fpl/artifacts/research
MOVA_RESEARCH_PROVIDER=codex_subscription
MOVA_RESEARCH_MIN_INTERVAL_SECONDS=21600
MOVA_RESEARCH_DEADLINE_WINDOW_SECONDS=108000
MOVA_COLLECTOR_FPL_CADENCE_SECONDS=21600
MOVA_COLLECTOR_ODDS_CADENCE_SECONDS=86400
MOVA_COLLECTOR_EVENTS_CADENCE_SECONDS=1800
MOVA_COLLECTOR_SCHEDULE_CADENCE_SECONDS=86400
MOVA_COLLECTOR_EVENT_BATCH_SIZE=10
MOVA_COLLECTOR_BROWSER_PATH=/usr/bin/chromium
MOVA_ODDS_API_CREDENTIAL_FILE=/run/secrets/odds_api_key
MOVA_ODDS_API_REGIONS=uk,eu
MOVA_ODDS_API_REGULAR_REGIONS=uk
MOVA_ODDS_API_MARKETS=h2h,totals
MOVA_ODDS_API_RESERVE_CREDITS=150
MOVA_ODDS_API_HARD_RESERVE_CREDITS=75
MOVA_POSTGRES_HOST=postgres
MOVA_POSTGRES_PORT=5432
MOVA_POSTGRES_DB=mova
MOVA_POSTGRES_USER=mova_owner
MOVA_POSTGRES_CREDENTIAL_FILE=/run/secrets/postgres_password
MOVA_LOG_LEVEL=INFO
