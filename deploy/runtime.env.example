# No contiene credenciales. Se instala como /etc/mova-fpl/runtime.env (0640).
MOVA_SEASON=2026-27
MOVA_TEAM_ID=3609854
MOVA_MODE=shadow
MOVA_ACTION_LEVEL=A0
MOVA_COMPLIANCE_GATE=pending
MOVA_ENABLE_SHADOW_DECISION=1
MOVA_ENABLE_BROWSER_WRITES=0
MOVA_OPS_DB=/var/lib/mova-fpl/db/ops.db
MOVA_TRACE_DB=/var/lib/mova-fpl/db/trace.db
MOVA_CANONICAL_DB=/var/lib/mova-fpl/db/fpl_canonical.db
MOVA_ARTIFACT_ROOT=/var/lib/mova-fpl/artifacts
MOVA_BACKUP_ROOT=/opt/orbital/backups/mova-fpl
MOVA_HOST_PROBE_PATH=/var/lib/mova-fpl/runtime/host-probe.json
MOVA_LOCK_PATH=/var/lib/mova-fpl/mova-fpl.lock
MOVA_SQLITE_MIN_VERSION=3.51.3
MOVA_MEMORY_GATE_BYTES=2684354560
MOVA_DISK_GATE_BYTES=21474836480
MOVA_API_HOST=0.0.0.0
MOVA_API_PORT=8787
MOVA_TICK_BUCKET_SECONDS=300
MOVA_DECISION_TIMEOUT_SECONDS=600
MOVA_PRIVATE_STATE_MAX_AGE_SECONDS=21600
MOVA_LOG_LEVEL=INFO
