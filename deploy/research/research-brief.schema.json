{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "research_run_id", "cycle_id", "request_sha256", "generated_at",
    "summary", "documents", "signals", "conflicts", "limitations", "usage"
  ],
  "properties": {
    "schema": {"type": "string", "const": "mova-research-brief-v1"},
    "research_run_id": {"type": "string"},
    "cycle_id": {"type": "string"},
    "request_sha256": {"type": "string"},
    "generated_at": {"type": "string"},
    "summary": {"type": "string", "maxLength": 3000},
    "documents": {
      "type": "array", "minItems": 1, "maxItems": 80,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_url", "title", "publisher", "published_at", "source_tier"],
        "properties": {
          "source_url": {"type": "string"},
          "title": {"type": "string"},
          "publisher": {"type": "string"},
          "published_at": {"type": ["string", "null"]},
          "source_tier": {"type": "string", "enum": ["official", "tier1", "tier2", "other"]}
        }
      }
    },
    "signals": {
      "type": "array", "maxItems": 120,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "subject_name", "player_element", "claim_type", "claim_text", "direction",
          "confidence", "source_urls", "expires_at"
        ],
        "properties": {
          "subject_name": {"type": "string"},
          "player_element": {"type": ["integer", "null"]},
          "claim_type": {
            "type": "string",
            "enum": ["availability", "injury", "suspension", "expected_minutes",
              "starting_role", "manager_comment", "fixture_context", "set_pieces",
              "transfer", "other"]
          },
          "claim_text": {"type": "string"},
          "direction": {"type": "string", "enum": ["positive", "negative", "neutral", "uncertain"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "source_urls": {
            "type": "array", "minItems": 1, "maxItems": 8,
            "items": {"type": "string"}
          },
          "expires_at": {"type": "string"}
        }
      }
    },
    "conflicts": {
      "type": "array", "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["subject", "claim_type", "description", "source_urls", "status"],
        "properties": {
          "subject": {"type": "string"},
          "claim_type": {
            "type": "string",
            "enum": ["availability", "injury", "suspension", "expected_minutes",
              "starting_role", "manager_comment", "fixture_context", "set_pieces",
              "transfer", "other"]
          },
          "description": {"type": "string"},
          "source_urls": {
            "type": "array", "minItems": 1, "maxItems": 8,
            "items": {"type": "string"}
          },
          "status": {"type": "string", "enum": ["unresolved", "resolved"]}
        }
      }
    },
    "limitations": {
      "type": "array", "maxItems": 20, "items": {"type": "string"}
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "input_tokens", "output_tokens"],
      "properties": {
        "model": {"type": "string"},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
