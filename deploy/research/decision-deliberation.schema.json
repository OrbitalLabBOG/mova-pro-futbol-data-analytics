{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "deliberation_id", "cycle_id", "envelope_id", "request_sha256",
    "generated_at", "strategist", "critic", "limitations", "usage"
  ],
  "properties": {
    "schema": {"type": "string", "const": "mova-decision-deliberation-v1"},
    "deliberation_id": {"type": "string"},
    "cycle_id": {"type": "string"},
    "envelope_id": {"type": "string"},
    "request_sha256": {"type": "string"},
    "generated_at": {"type": "string"},
    "strategist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary", "preferred_candidate_key", "confidence", "horizon_assessment",
        "tradeoffs", "intervention"
      ],
      "properties": {
        "summary": {"type": "string", "maxLength": 3000},
        "preferred_candidate_key": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "horizon_assessment": {
          "type": "array", "maxItems": 20,
          "items": {"type": "string", "maxLength": 500}
        },
        "tradeoffs": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["candidate_key", "advantages", "disadvantages"],
            "properties": {
              "candidate_key": {"type": "string"},
              "advantages": {
                "type": "array", "maxItems": 10,
                "items": {"type": "string", "maxLength": 500}
              },
              "disadvantages": {
                "type": "array", "maxItems": 10,
                "items": {"type": "string", "maxLength": 500}
              }
            }
          }
        },
        "intervention": {
          "type": "object", "additionalProperties": false,
          "required": [
            "gw", "author", "rationale", "xp_multiplier", "allow_chips",
            "block_chips", "lock_in", "lock_out", "risk_lambda"
          ],
          "properties": {
            "gw": {"type": "integer", "minimum": 1, "maximum": 38},
            "author": {"type": "string", "const": "strategist"},
            "rationale": {"type": "string", "maxLength": 2000},
            "xp_multiplier": {
              "type": "object",
              "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1.5}
            },
            "allow_chips": {
              "type": "array", "uniqueItems": true,
              "items": {"type": "string", "enum": [
                "wildcard", "free_hit", "bench_boost", "triple_captain"
              ]}
            },
            "block_chips": {
              "type": "array", "uniqueItems": true,
              "items": {"type": "string", "enum": [
                "wildcard", "free_hit", "bench_boost", "triple_captain"
              ]}
            },
            "lock_in": {
              "type": "array", "maxItems": 12, "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            },
            "lock_out": {
              "type": "array", "maxItems": 12, "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            },
            "risk_lambda": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "critic": {
      "type": "object", "additionalProperties": false,
      "required": [
        "verdict", "summary", "confidence", "risks", "challenged_assumptions",
        "required_followups"
      ],
      "properties": {
        "verdict": {"type": "string", "enum": ["accept", "revise", "block"]},
        "summary": {"type": "string", "maxLength": 3000},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "risks": {
          "type": "array", "maxItems": 40,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "severity", "candidate_key", "claim", "mitigation"],
            "properties": {
              "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,79}$"},
              "severity": {"type": "string", "enum": ["info", "warning", "block"]},
              "candidate_key": {"type": ["string", "null"]},
              "claim": {"type": "string", "maxLength": 1000},
              "mitigation": {"type": "string", "maxLength": 1000}
            }
          }
        },
        "challenged_assumptions": {
          "type": "array", "maxItems": 20,
          "items": {"type": "string", "maxLength": 500}
        },
        "required_followups": {
          "type": "array", "maxItems": 20,
          "items": {"type": "string", "maxLength": 500}
        }
      }
    },
    "limitations": {
      "type": "array", "maxItems": 20,
      "items": {"type": "string", "maxLength": 500}
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "input_tokens", "output_tokens"],
      "properties": {
        "model": {"type": "string"},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
