# MOVA FPL owner dashboard. Only the two human HTML routes are public; the
# diagnostic API and metrics remain reachable exclusively from VPS loopback.
mova.72-60-245-2.sslip.io {
	encode gzip

	@owner_dashboard path / /dashboard
	handle @owner_dashboard {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		respond "Not found" 404
	}

	handle_errors {
		@server_error expression {err.status_code} >= 500
		respond @server_error "MOVA no está respondiendo. Avísale a ORBIX." 503
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Cache-Control "no-store"
		-Server
	}

	log {
		output file /var/log/caddy/mova-fpl.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}
