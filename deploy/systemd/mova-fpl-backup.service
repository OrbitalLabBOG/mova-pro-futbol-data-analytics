[Unit]
Description=MOVA FPL verified SQLite and PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=@@REPO_DIR@@
EnvironmentFile=-/etc/mova-fpl/deploy.env
ExecStart=/usr/bin/flock -n -E 75 /run/lock/mova-fpl-worker.lock @@REPO_DIR@@/deploy/bin/backup-all.sh
SuccessExitStatus=75
TimeoutStartSec=900
Nice=10
