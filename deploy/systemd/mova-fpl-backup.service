[Unit]
Description=MOVA FPL verified SQLite backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=@@REPO_DIR@@
EnvironmentFile=-/etc/mova-fpl/deploy.env
ExecStart=/usr/bin/flock -n /run/lock/mova-fpl-worker.lock /usr/bin/docker compose --profile jobs run --rm --no-deps worker python -m mova_fpl.ops.cli backup --retention-days 35
TimeoutStartSec=900
Nice=10
