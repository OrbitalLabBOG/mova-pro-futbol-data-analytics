[Unit]
Description=MOVA FPL encrypted off-host operational database backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=@@REPO_DIR@@
EnvironmentFile=-/etc/mova-fpl/deploy.env
ExecStart=/usr/bin/flock -n -E 75 /run/lock/mova-fpl-offsite-backup.lock /usr/bin/flock -w 300 -E 75 /run/lock/mova-fpl-worker.lock @@REPO_DIR@@/deploy/bin/offsite-backup.sh
SuccessExitStatus=75
TimeoutStartSec=1800
Nice=10
PrivateTmp=true
NoNewPrivileges=true
