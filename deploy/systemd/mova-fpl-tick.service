[Unit]
Description=MOVA FPL idempotent shadow tick
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=@@REPO_DIR@@
EnvironmentFile=-/etc/mova-fpl/deploy.env
ExecStart=/usr/bin/flock -n /run/lock/mova-fpl-worker.lock /usr/bin/docker compose --profile jobs run --rm --no-deps worker python -m mova_fpl.ops.cli tick
TimeoutStartSec=900
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
