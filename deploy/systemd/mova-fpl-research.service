[Unit]
Description=MOVA FPL isolated Codex research cycle
Requires=docker.service
After=docker.service network-online.target mova-fpl-stack.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@@REPO_DIR@@
EnvironmentFile=-/etc/mova-fpl/deploy.env
ExecStart=/usr/bin/flock -n /run/lock/mova-fpl-research-host.lock @@REPO_DIR@@/deploy/bin/research-cycle.sh
SuccessExitStatus=75
TimeoutStartSec=10min
Nice=10

[Install]
WantedBy=multi-user.target
