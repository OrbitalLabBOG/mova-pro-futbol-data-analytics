[Unit]
Description=MOVA FPL bounded autonomous lineup delivery
Requires=docker.service
After=docker.service network-online.target mova-fpl-stack.service

[Service]
Type=oneshot
WorkingDirectory=@@REPO_DIR@@
EnvironmentFile=-/etc/mova-fpl/deploy.env
ExecStart=@@REPO_DIR@@/deploy/bin/delivery-cycle.sh
SuccessExitStatus=75
TimeoutStartSec=15min
Nice=5
