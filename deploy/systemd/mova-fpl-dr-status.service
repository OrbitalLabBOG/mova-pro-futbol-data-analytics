[Unit]
Description=MOVA FPL DR metadata and recovery preflight
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=@@REPO_DIR@@
EnvironmentFile=-/etc/mova-fpl/deploy.env
ExecStart=@@REPO_DIR@@/deploy/bin/dr-status.sh
TimeoutStartSec=180
Nice=15
