# Metadata no secreta usada por Compose/systemd. Reemplazar con el SHA desplegado.
MOVA_GIT_SHA=release
MOVA_IMAGE_TAG=release
MOVA_DATA_ROOT=/var/lib/mova-fpl
MOVA_BACKUP_ROOT=/opt/orbital/backups/mova-fpl
MOVA_BROWSER_PROFILE=/var/lib/mova-fpl/browser-profile
MOVA_ENV_FILE=/etc/mova-fpl/runtime.env
MOVA_API_PORT=8787
MOVA_NOVNC_PORT=6080
