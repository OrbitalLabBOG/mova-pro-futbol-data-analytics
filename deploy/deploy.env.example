# Metadata no secreta usada por Compose/systemd. Reemplazar con el SHA desplegado.
MOVA_GIT_SHA=release
MOVA_IMAGE_TAG=release
MOVA_DATA_ROOT=/var/lib/mova-fpl
MOVA_BACKUP_ROOT=/opt/orbital/backups/mova-fpl
MOVA_BROWSER_PROFILE=/var/lib/mova-fpl/browser-profile
MOVA_ENV_FILE=/etc/mova-fpl/runtime.env
MOVA_API_PORT=8787
MOVA_NOVNC_PORT=6080
MOVA_POSTGRES_DB=mova
MOVA_POSTGRES_USER=mova_owner
MOVA_POSTGRES_PASSWORD_FILE=/etc/mova-fpl/postgres-password
MOVA_POSTGRES_APP_PASSWORD_FILE=/etc/mova-fpl/postgres-app-password
MOVA_POSTGRES_READONLY_PASSWORD_FILE=/etc/mova-fpl/postgres-readonly-password
MOVA_ALERT_WEBHOOK_CONFIG_FILE=/etc/mova-fpl/alert-webhook.json
MOVA_CODEX_HOME=/var/lib/mova-fpl/codex-home
MOVA_RESEARCH_MODEL=gpt-5.6-luna
MOVA_RESEARCH_REASONING_EFFORT=medium
MOVA_DELIBERATION_MODEL=gpt-5.6-terra
MOVA_DELIBERATION_REASONING_EFFORT=high
MOVA_RESEARCH_TIMEOUT_MS=480000
